{
  "_comment": "Flowpilot controls and version switching",
  "menuName": "Flow Pilot",
  "menuIcon": "icon_device.png",
  "menuDescription": "Flow Pilot settings",
  "persistentParams": [],
  "clearOnManagerStartParams": [],
  "clearOnOnroadTransitionParams": [],
  "clearOnOffroadTransitionParams": [],
  "groups": [
    {
      "groupName": "flowpilotSteeringGroup",
      "title": "Flow Pilot Steering",
      "enableResetButton": false,
      "controls": [
        {
          "type": "selection",
          "param": "FordSteerDriverAllowance",
          "title": "Driver Torque Override Threshold",
          "desc": "Steering torque (Nm) required to consider the driver overriding lateral control. Higher values require stronger driver input before Flow Pilot disengages steering.",
          "options": [
            { "name": "1.0 Nm", "value": "1.0" },
            { "name": "1.5 Nm", "value": "1.5" },
            { "name": "2.0 Nm", "value": "2.0" },
            { "name": "2.5 Nm", "value": "2.5" },
            { "name": "3.0 Nm", "value": "3.0", "default": true }
          ]
        }
      ]
    },
    {
      "groupName": "flowpilotVersionGroup",
      "title": "Flow Pilot Version",
      "enableResetButton": false,
      "controls": [
        {
          "type": "command_button",
          "title": "Fetch Updates",
          "desc": "Refresh branch and commit lists from remotes.",
          "button_text": "FETCH",
          "action": "flowpilot_git_sync",
          "confirm": true,
          "confirm_text": "Fetch updates from remotes now?",
          "confirm_button_text": "Fetch",
          "cancel_button_text": "Cancel"
        },
        {
          "type": "selection",
          "param": "FlowpilotTargetBranch",
          "title": "Target Branch",
          "desc": "Pick a branch (sorted by most recent commit).",
          "options": []
        },
        {
          "type": "selection",
          "param": "FlowpilotTargetRef",
          "title": "Target Commit",
          "desc": "Select from the last 20 commits in the selected branch (newest first).",
          "options": []
        },
        {
          "type": "command_button",
          "title": "Restart Flow Pilot Back-End",
          "desc": "Checkout the selected ref and restart Flow Pilot services.",
          "button_text": "SWITCH & RESTART",
          "action": "flowpilot_checkout",
          "param": "FlowpilotTargetRef",
          "confirm": true,
          "confirm_text": "This will checkout the selected ref and restart Flow Pilot. Continue?",
          "confirm_button_text": "Switch & Restart",
          "cancel_button_text": "Cancel"
        },
        {
          "type": "command_button",
          "title": "Stash & Restart Flow Pilot",
          "desc": "Stash local changes, checkout the selected ref, and restart Flow Pilot services.",
          "button_text": "STASH & RESTART",
          "action": "flowpilot_checkout_stash",
          "param": "FlowpilotTargetRef",
          "confirm": true,
          "confirm_text": "This will stash local changes, checkout the selected ref, and restart Flow Pilot. Continue?",
          "confirm_button_text": "Stash & Restart",
          "cancel_button_text": "Cancel",
          "button_style": {
            "background_color": "#FF8C00",
            "background_color_pressed": "#FFA500",
            "text_color": "#FFFFFF"
          }
        }
      ]
    }
  ]
}
